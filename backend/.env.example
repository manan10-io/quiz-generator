# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=QuizGen AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
# ENVIRONMENT=production disables /docs and /redoc

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev (SQLite, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./quizgen.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/quizgen

# ─── Redis (Celery broker + cache, optional for MVP) ──────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-to-a-random-32-plus-character-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
# Must match the client ID/secret configured in the frontend's .env.local
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ─── AI Cleanup (Anthropic) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_CLEANUP_ENABLED=true
AI_MODEL=claude-haiku-4-5-20251001

# ─── OCR ──────────────────────────────────────────────────────────────────────
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng+hin+guj

# Google Vision API fallback (optional — improves accuracy on poor scans)
GOOGLE_VISION_API_KEY=
USE_GOOGLE_VISION=false

# ─── File upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
UPLOAD_DIR=/tmp/quizgen_uploads

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list is NOT supported directly — this is a JSON-style list
# in pydantic-settings; for a single origin just use one URL per deployment.
CORS_ORIGINS=["http://localhost:3000"]

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
