# ─── Root .env — used by docker-compose.yml ────────────────────────────────────
# Copy this file to `.env` in the project root before running:
#   docker compose up --build
#
# Individual backend/ and frontend/ .env files are NOT used in Docker —
# docker-compose.yml injects these values directly into each container's
# environment. Use backend/.env.example and frontend/.env.local.example
# only when running each service outside Docker (e.g. `npm run dev` /
# `uvicorn app.main:app --reload` directly on your machine).

# ─── Required — compose will refuse to start without these ───────────────────

# JWT signing secret shared by the backend for API tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# NextAuth session secret (different from JWT_SECRET above).
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# From Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID with:
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#   Enabled APIs: Google Forms API, Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional ─────────────────────────────────────────────────────────────────

GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Anthropic API key for AI-powered parse cleanup (Phase 3). If left empty,
# AI_CLEANUP_ENABLED is still read but the feature silently no-ops.
ANTHROPIC_API_KEY=
AI_CLEANUP_ENABLED=true

# Google Cloud Vision API key for OCR fallback on low-confidence scans
# (Phase 4). Leave USE_GOOGLE_VISION=false to rely on Tesseract only.
GOOGLE_VISION_API_KEY=
USE_GOOGLE_VISION=false
